# Модель. Подключение меняется одной настройкой LLM_PROVIDER:
#   openai   = любой сервис с OpenAI-совместимым API, в том числе модель в своем контуре (vLLM, Ollama)
#   gigachat = GigaChat API (Сбер)
#   bridge   = мост разработки без ключа: так работает демо-стенд, см. README, раздел "Модель"
LLM_PROVIDER=openai
LLM_MODEL=claude-sonnet-5-5
# имя модели для экрана: его показывают чат и экран оператора; пусто = LLM_MODEL
LLM_LABEL=Claude Sonnet 5.5
LLM_BASE_URL=
LLM_API_KEY=

# Цена модели в рублях за 1000 токенов: из нее стенд считает стоимость запроса.
# Здесь Claude Sonnet 5.5 ($2 и $10 за 1 млн токенов); для GigaChat-2-Max 0.65 и 0.65
PRICE_IN_PER_1K=0.164626
PRICE_OUT_PER_1K=0.82313

# GigaChat (если LLM_PROVIDER=gigachat): ключ авторизации из кабинета developers.sber.ru, проект GigaChat API
# LLM_MODEL=GigaChat-2-Max
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Мост разработки (если LLM_PROVIDER=bridge): каталог обмена, сколько секунд ждать ответа и через сколько
# секунд без отметки исполнителя считать, что отвечать некому (0 = не проверять, так идут пакетные прогоны)
# BRIDGE_DIR=data/runtime/bridge
# BRIDGE_TIMEOUT=90
# BRIDGE_ALIVE_SEC=150

# Ключ оператора: длинная случайная строка. С ним экран /admin?token=... показывает контакты клиентов и дает
# отвечать, выгружать журнал и обновлять каталог. Без ключа экран открыт только на чтение, контакты скрыты.
ADMIN_TOKEN=

# Нагрузка и расход на публичном адресе
# ходов одновременно; GigaChat для физлиц держит один поток
MAX_PARALLEL_TURNS=4
# секунд на один ход клиента, 0 = без предела
TURN_DEADLINE=60
# сообщений в минуту с одного адреса, 0 = без предела
CHAT_RATE_PER_MIN=10
# потолок расхода на модель за сутки в рублях, 0 = без потолка
DAILY_BUDGET_RUB=500
# сколько дней хранятся диалоги с контактами клиентов
RETENTION_DAYS=90
# прошлый визит старше этого агент не вспоминает
PREVIOUS_VISIT_DAYS=30

# Каталог: фид магазина и час ежедневного обновления по Москве; пустой FEED_URL = не обновлять
FEED_URL=https://store.softline.ru/feeds/Softline.yml.gz
FEED_UPDATE_HOUR=4

# Экономика на экране оператора: объем обращений (цифра заказчика) и допущения, которые меняются и на экране
REQUESTS_PER_HALF_YEAR=500
# расход на модель за полгода, который заказчик назвал приемлемым; 0 = не показывать
MODEL_BUDGET_HALF_YEAR_RUB=7000
MANAGER_MIN_PER_REQUEST=30
MANAGER_RUB_PER_HOUR=600
CARD_SAVES_SHARE=0.5
# пояснение на экране оператора: что за диалоги лежат на стенде
STAND_NOTE=
# скидка, которую агент дает сам, проценты; больше согласует менеджер (ответ заказчика на брифе); 0 = не дает
AGENT_DISCOUNT_MAX=5
# подписант КП: подписант из шаблона заказчика (имя, должность, подпись под чертой); пусто = нейтральный
# KP_SIGNER_NAME=
# KP_SIGNER_TITLE=
# KP_SIGNER_SHORT=
# срок реакции менеджера на обращение в минутах: срочное, обычное, прочее
SLA_MINUTES=2,5,15
# рабочих дней в месяце: для расчета расхода на модель в день
WORKDAYS_PER_MONTH=21

# Обращения менеджеру в Telegram: карточка обращения и черновик КП приходят в чат менеджеров, ответ реплаем
# уходит клиенту в чат сайта. Бота создают в @BotFather; номер чата бот назовет сам, если написать ему из этого чата
# TG_TOKEN=
# TG_CHAT=
# PUBLIC_URL=https://ai-support.example.ru

# Сколько своих прокси стоит перед сервером (Caddy или nginx перед контейнером = 1). Адрес клиента для лимита
# частоты берется из X-Forwarded-For с конца: начало списка пишет сам клиент. Поэтому порт сервиса наружу напрямую
# не публикуется (в docker-compose.yml он привязан к 127.0.0.1): иначе клиент пришлет поддельный X-Forwarded-For
# и обойдет лимит частоты. Без прокси (порт открыт напрямую) ставьте 0: тогда берется адрес соединения
# PROXY_HOPS=1
