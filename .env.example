# Модель. gigachat = GigaChat API (Сбер). openai = любой OpenAI-совместимый сервис,
# в том числе модель с открытыми весами в своем контуре (vLLM, Ollama).
LLM_PROVIDER=gigachat
LLM_MODEL=GigaChat-2-Max

# GigaChat: ключ авторизации из личного кабинета developers.sber.ru (проект GigaChat API)
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# OpenAI-совместимый сервис (если LLM_PROVIDER=openai)
LLM_BASE_URL=
LLM_API_KEY=

# Цена модели в рублях за 1000 токенов: из нее стенд считает стоимость запроса
PRICE_IN_PER_1K=0.65
PRICE_OUT_PER_1K=0.65
